 tmserver/internal/handler/guild_chat_test.go | 185 +++++++++++++++++++
 tmserver/internal/handler/handler_test.go    |   4 +-
 tmserver/internal/world/session.go           |   1 +
 4 files changed, 263 insertions(+), 1 deletion(-)
 create mode 100644 tmserver/internal/handler/guild_chat_test.go

