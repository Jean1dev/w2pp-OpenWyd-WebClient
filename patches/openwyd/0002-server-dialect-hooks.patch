 #include <cstdio>
 #include <cstdint>
@@ -1086,20 +1087,52 @@ bool CPSock::SendMessageA()
 	return false;
 }
 
-int CPSock::SendOneMessage(char* Msg, int Size)
+// Every scene-built message crosses the server dialect before obfuscation:
+// translated, sent as-is when the layout is verified identical, or dropped.
+// Credential fields are wiped from the scene struct, the translated copy and
+// the send buffer once the bytes have left CPSock.
+int CPSock::SendDialect(char* Msg, int Size, int Keyword, bool bKeyword)
 {
-	WydSocketRecordSentOpcode(Msg, Size);
-	AddMessage(Msg, Size);
+	char wire[WYD_DIALECT_MAX_FRAME];
+	int wireSize = 0;
+	const int dialect = WydDialectOutbound(Msg, Size, wire, sizeof(wire), &wireSize);
+	if (dialect == WYD_DIALECT_DROP)
+	{
+		WydDialectScrubOutbound(Msg, Size);
+		return 0;
+	}
 
-	return SendMessageA();
+	char* out = dialect == WYD_DIALECT_TRANSLATED ? wire : Msg;
+	const int outSize = dialect == WYD_DIALECT_TRANSLATED ? wireSize : Size;
+	const int bufferAt = nSendPosition;
+	WydSocketRecordSentOpcode(out, outSize);
+	if (bKeyword)
+		AddMessage(out, outSize, Keyword);
+	else
+		AddMessage(out, outSize);
+
+	const int result = SendMessageA();
+	if (WydDialectIsCredential(Msg, Size) && bufferAt + outSize <= SEND_BUFFER_SIZE)
+	{
+		volatile char* sent = pSendBuffer + bufferAt;
+		for (int i = 0; i < outSize; ++i)
+			sent[i] = 0;
+	}
+	WydDialectScrubOutbound(Msg, Size);
+	volatile char* scratch = wire;
+	for (int i = 0; i < wireSize; ++i)
+		scratch[i] = 0;
+	return result;
 }
 
-int CPSock::SendOneMessageKeyword(char* Msg, int Size, int Keyword)
+int CPSock::SendOneMessage(char* Msg, int Size)
 {
-	WydSocketRecordSentOpcode(Msg, Size);
-	AddMessage(Msg, Size, Keyword);
+	return SendDialect(Msg, Size, 0, false);
+}
 
-	return SendMessageA();
+int CPSock::SendOneMessageKeyword(char* Msg, int Size, int Keyword)
+{
+	return SendDialect(Msg, Size, Keyword, true);
 }
 
 int CPSock::AddMessage2(char* pMsg, int Size)
