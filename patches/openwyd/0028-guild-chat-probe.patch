Etapa 5: read-only probe of the guild chat button (m_pChatGuild). The
"Guild Chatting : Off/On" panel lasts 4 s and the chat list gets the
localized strings 450 + 447/446, so neither is a stable check; the button
state is what SetGuildChat leaves behind, and only for the exact text.

diff --git a/webclient/client-wasm/compat/src/wyd_client_entry.cpp b/webclient/client-wasm/compat/src/wyd_client_entry.cpp
--- a/webclient/client-wasm/compat/src/wyd_client_entry.cpp
+++ b/webclient/client-wasm/compat/src/wyd_client_entry.cpp
@@ -1202,6 +1202,15 @@
   return it && it->GetText() ? it->GetText() : "";
 }
 
+// Guild chat button (m_pChatGuild): TMScene::OnPacketEvent calls SetGuildChat
+// only for the exact panels "Guild Chatting : Off/On" (the chat list then gets
+// strings 450 + 447/446), and SetGuildChat flips m_bSelected. 0/1, or -1
+// outside the Field. Read-only.
+extern "C" WYD_EXPORT int wyd_field_guild_chat_selected() {
+  TMFieldScene* f = WydField();
+  return f && f->m_pChatGuild ? (f->m_pChatGuild->m_bSelected ? 1 : 0) : -1;
+}
+
