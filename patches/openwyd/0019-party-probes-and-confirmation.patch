+// Party probes: snapshots and the rendered row center, never input shortcuts.
+extern "C" WYD_EXPORT int wyd_field_party_count() {
+  auto* f = WydField();
+  return f && f->m_pPartyList ? f->m_pPartyList->m_nNumItem : 0;
+}
+extern "C" WYD_EXPORT int wyd_field_party_value(int row, int field) {
+  auto* f = WydField();
+  if (!f || !f->m_pPartyList || row < 0 || row >= f->m_pPartyList->m_nNumItem) return -1;
+  auto* p = static_cast<SListBoxPartyItem*>(f->m_pPartyList->m_pItemList[row]);
+  if (!p) return -1;
+  switch (field) {
+    case 0: return p->m_dwCharID;
+    case 1: return p->m_nState; // 1 invite, 2 leader, 0 member
+    case 2: return p->m_nLevel;
+    case 3: return p->m_nClass;
+    case 4: return static_cast<int>(p->m_GCText.nPosX + 25);
+    case 5: return static_cast<int>(p->m_GCText.nPosY + 7);
+  }
+  return -1;
+}
+extern "C" WYD_EXPORT int wyd_field_party_member(unsigned int id) {
+  auto* p = g_pObjectManager ? static_cast<TMHuman*>(g_pObjectManager->GetHumanByID(id)) : nullptr;
+  return p ? p->m_bParty : -1;
+}
+extern "C" WYD_EXPORT int wyd_field_party_menu_target() {
+  auto* f = WydField();
+  return f && f->m_pPGTPanel && f->m_pPGTPanel->IsVisible() ? f->m_dwOpID : 0;
+}
