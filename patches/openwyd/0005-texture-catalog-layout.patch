+// Texture catalogs (*TextureList*.bin) exist in two record layouts:
+//   528 bytes: szFileName[255], szFilePart[255], cAlpha@510, 4 DWORDs (this runtime's base);
+//   264 bytes: szFileName[255], cAlpha@255, 2 DWORDs (7662 client data).
+// Reading a 264-byte file with the 528-byte struct maps index N to record 2N
+// and leaves every index past the half empty, so every texture is wrong or
+// missing. The layout is chosen from the content: a record counts only if its
+// name is a plausible path and its alpha byte is one of the loader's codes.
+static int WydReadTextureCatalog(const char* path, stTextureListInfo* out, int maxRecords)
+{
+	FILE* fp = fopen(path, "rb");
+	if (!fp)
+		return 0;
+	fseek(fp, 0, SEEK_END);
+	const long size = ftell(fp);
+	fseek(fp, 0, SEEK_SET);
+	std::vector<char> buf(size > 0 ? static_cast<size_t>(size) : 0u);
+	const size_t got = buf.empty() ? 0 : fread(buf.data(), 1, buf.size(), fp);
+	fclose(fp);
+	if (got != buf.size())
+		return 0;
+
+	auto valid = [&](long off, int alphaOff) {
+		if (off + alphaOff >= size)
+			return false;
+		const char* p = &buf[static_cast<size_t>(off)];
+		if (!p[0] || static_cast<unsigned char>(p[0]) == 0xCD)
+			return false;
+		const char* end = static_cast<const char*>(memchr(p, 0, 255));
+		if (!end || !memchr(p, '.', static_cast<size_t>(end - p)))
+			return false;
+		const char a = p[alphaOff];
+		return a == 'N' || a == 'A' || a == 'a' || a == 'C';
+	};
+	int n264 = 0, n528 = 0;
+	for (int i = 0; i < maxRecords; ++i)
+	{
+		n264 += valid(static_cast<long>(i) * 264, 255) ? 1 : 0;
+		n528 += valid(static_cast<long>(i) * 528, 510) ? 1 : 0;
+	}
+	const int stride = n264 > n528 ? 264 : 528;
+	const int alphaOff = stride == 264 ? 255 : 510;
+
+	memset(out, 0, sizeof(stTextureListInfo) * static_cast<size_t>(maxRecords));
+	for (int i = 0; i < maxRecords; ++i)
+	{
+		const long off = static_cast<long>(i) * stride;
+		if (off + alphaOff >= size)
+			break;
+		const char* p = &buf[static_cast<size_t>(off)];
+		const char* end = static_cast<const char*>(memchr(p, 0, 255));
+		const size_t len = end ? static_cast<size_t>(end - p) : 254u;
+		if (len && static_cast<unsigned char>(p[0]) != 0xCD)
+			memcpy(out[i].szFileName, p, len);
+		if (stride == 528)
+		{
+			const char* part = p + 255;
+			const char* partEnd = static_cast<const char*>(memchr(part, 0, 255));
+			const size_t partLen = partEnd ? static_cast<size_t>(partEnd - part) : 254u;
+			if (partLen && static_cast<unsigned char>(part[0]) != 0xCD)
+				memcpy(out[i].szFilePart, part, partLen);
+		}
+		out[i].cAlpha = p[alphaOff];
+	}
+	LOG_WRITELOG("texture catalog %s: record %d bytes (%d/%d plausible)\n", path, stride, n264, n528);
+	return stride;
+}
