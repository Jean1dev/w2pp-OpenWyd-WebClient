@@ -651,6 +651,45 @@ def capture_startup_link_contract(
     return payload
 
 
+# Sources whose EMSCRIPTEN_KEEPALIVE (WYD_EXPORT) functions the page may call.
+PUBLIC_KEEPALIVE_SOURCES = (
+    "webclient/client-wasm/compat/src/wyd_client_entry.cpp",
+    "Projects/TMProject/WydDialect.cpp",
+)
+PUBLIC_EXCLUDED_PREFIX = "_wyd_debug_"
+_KEEPALIVE_EXPORT = re.compile(
+    r"\b(?:WYD_EXPORT|EMSCRIPTEN_KEEPALIVE)\b[^;{(]*?\b(wyd_[A-Za-z0-9_]+)\s*\("
+)
+
+
+def keepalive_exports(repo_root: Path) -> list[str]:
+    names: list[str] = []
+    for rel in PUBLIC_KEEPALIVE_SOURCES:
+        text = (repo_root / rel).read_text(encoding="utf-8", errors="replace")
+        names.extend(f"_{name}" for name in _KEEPALIVE_EXPORT.findall(text))
+    return names
+
+
+def apply_public_exports(repo_root: Path, link_cmd: list[str]) -> None:
+    """Published build: KEEPALIVE no longer exports by itself, so the export
+    list is explicit and every _wyd_debug_* entry point (UI automation, fake
+    time, camera and item probes used by the test harness) stays internal."""
+    for index, arg in enumerate(link_cmd):
+        if arg.startswith("-sEXPORTED_FUNCTIONS=["):
+            listed = re.findall(r"'([^']+)'", arg)
+            break
+    else:
+        raise RuntimeError("public build: -sEXPORTED_FUNCTIONS not found")
+    names = list(dict.fromkeys([*listed, *keepalive_exports(repo_root)]))
+    public = [name for name in names if not name.startswith(PUBLIC_EXCLUDED_PREFIX)]
+    link_cmd[index] = "-sEXPORTED_FUNCTIONS=[" + ",".join(repr(name) for name in public) + "]"
+    link_cmd.insert(index + 1, "-sEXPORT_KEEPALIVE=0")
+    print(
+        f"[startup-link] public exports: {len(public)} kept, "
+        f"{len(names) - len(public)} {PUBLIC_EXCLUDED_PREFIX}* removed"
+    )
+
+
