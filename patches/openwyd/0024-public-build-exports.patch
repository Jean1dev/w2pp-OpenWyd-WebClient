diff --git a/webclient/client-wasm/tools/link_tmproject_wasm_startup.py b/webclient/client-wasm/tools/link_tmproject_wasm_startup.py
index 0308f9f..5c233cc 100755
--- a/webclient/client-wasm/tools/link_tmproject_wasm_startup.py
+++ b/webclient/client-wasm/tools/link_tmproject_wasm_startup.py
@@ -651,6 +651,32 @@ def capture_startup_link_contract(
     return payload
 
 
+DEBUG_EXPORT_PREFIX = "_wyd_debug_"
+_DEBUG_EXPORT = re.compile(r"\bWYD_DEBUG_EXPORT\b[^;{(]*?\b(wyd_debug_[A-Za-z0-9_]+)\s*\(")
+
+
+def debug_exports(repo_root: Path) -> list[str]:
+    """Harness entry points of wyd_client_entry.cpp, exported by name."""
+    text = (repo_root / "webclient/client-wasm/compat/src/wyd_client_entry.cpp").read_text(
+        encoding="utf-8", errors="replace"
+    )
+    return [f"_{name}" for name in _DEBUG_EXPORT.findall(text)]
+
+
+def drop_debug_exports(link_cmd: list[str]) -> None:
+    """Published build: no _wyd_debug_* name (UI automation, fake time, camera
+    and item probes used by the test harness) stays in EXPORTED_FUNCTIONS."""
+    for index, arg in enumerate(link_cmd):
+        if arg.startswith("-sEXPORTED_FUNCTIONS=["):
+            names = re.findall(r"'([^']+)'", arg)
+            kept = [name for name in names if not name.startswith(DEBUG_EXPORT_PREFIX)]
+            link_cmd[index] = "-sEXPORTED_FUNCTIONS=[" + ",".join(repr(name) for name in kept) + "]"
+            print(f"[startup-link] public exports: {len(kept)} kept, "
+                  f"{len(names) - len(kept)} {DEBUG_EXPORT_PREFIX}* removed")
+            return
+    raise RuntimeError("public build: -sEXPORTED_FUNCTIONS not found")
+
+
 def write_response_file(path: Path, args: list[str]) -> None:
     """Write arguments in the format consumed by Emscripten response files.
 
