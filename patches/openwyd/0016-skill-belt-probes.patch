Read-only probes for using a learned skill: the skill window ("S")
visibility, each learned-skill cell's item and on-screen center, the skill
belt slots and the selected slot. The harness assigns the skill with the
original hover + Shift+digit and casts with a real right click; nothing here
sends a packet or changes state.

diff --git a/webclient/client-wasm/compat/src/wyd_client_entry.cpp b/webclient/client-wasm/compat/src/wyd_client_entry.cpp
--- a/webclient/client-wasm/compat/src/wyd_client_entry.cpp
+++ b/webclient/client-wasm/compat/src/wyd_client_entry.cpp
@@ -894,6 +894,46 @@ extern "C" WYD_EXPORT int wyd_field_my_skill_bonus() {
   return g_pObjectManager ? g_pObjectManager->m_stMobData.SkillBonus : -1;
 }
 
+// Skill window "S" and the skill belt (stage 5 skill use, read-only). The
+// original assigns a skill by hovering it in the skill window and pressing
+// Shift+digit (OnKeyShortSkill -> SetShortSkill -> 0x0378); the harness does
+// exactly that with real input and reads the result here.
+extern "C" WYD_EXPORT int wyd_field_skill_panel_visible() {
+  if (!g_pCurrentScene || g_pCurrentScene->GetSceneType() != ESCENE_TYPE::ESCENE_FIELD)
+    return 0;
+  auto* f = static_cast<TMFieldScene*>(g_pCurrentScene);
+  return f->m_pSkillPanel && f->m_pSkillPanel->IsVisible() ? 1 : 0;
+}
+
+// Learned-skill cell i (0..23, the class skill position): its item (5000+idx)
+// and the center of its panel as last laid out (which = 0 x, 1 y), canvas px.
+extern "C" WYD_EXPORT int wyd_field_skill_cell_item(int i) {
+  if (!g_pCurrentScene || g_pCurrentScene->GetSceneType() != ESCENE_TYPE::ESCENE_FIELD || i < 0 || i >= 24)
+    return 0;
+  SGridControl* g = static_cast<TMFieldScene*>(g_pCurrentScene)->m_pSkillSecGrid[i];
+  SGridControlItem* it = g ? g->GetItem(0, 0) : nullptr;
+  return it && it->m_pItem ? it->m_pItem->sIndex : 0;
+}
+
+extern "C" WYD_EXPORT int wyd_field_skill_cell_screen(int i, int which) {
+  if (!g_pCurrentScene || g_pCurrentScene->GetSceneType() != ESCENE_TYPE::ESCENE_FIELD || i < 0 || i >= 24)
+    return -1;
+  SGridControl* g = static_cast<TMFieldScene*>(g_pCurrentScene)->m_pSkillSecGrid[i];
+  if (!g || g->m_GCPanel.nWidth <= 0 || g->m_GCPanel.nHeight <= 0) return -1;
+  return static_cast<int>(which == 0 ? g->m_GCPanel.nPosX + g->m_GCPanel.nWidth / 2
+                                     : g->m_GCPanel.nPosY + g->m_GCPanel.nHeight / 2);
+}
+
+// Belt slot 0..19 (skill index, 255 = empty) and the selected slot.
+extern "C" WYD_EXPORT int wyd_field_short_skill(int slot) {
+  if (!g_pObjectManager || slot < 0 || slot >= 20) return -1;
+  return static_cast<unsigned char>(g_pObjectManager->m_cShortSkill[slot]);
+}
+
+extern "C" WYD_EXPORT int wyd_field_selected_short_skill() {
+  return g_pObjectManager ? g_pObjectManager->m_cSelectShortSkill : -1;
+}
+
 extern "C" int wyd_start_client() {
   wchar_t empty_cmdline[] = L"";
   return wWinMain(reinterpret_cast<HINSTANCE>(1), nullptr, empty_cmdline, 1);
