+// Width in pixels of a UI texture file, read from its header (0 if unknown).
+// .wyt = 4-byte tag + TGA header (width @12); .wys = 1-byte tag + DDS (width @16).
+static int WydUITextureFileWidth(const char* path)
+{
+	// Same open path as the texture loaders (_open), which the web build maps
+	// for backslashes and case.
+	const int handle = _open(path, _O_BINARY);
+	if (handle == -1)
+		return 0;
+	unsigned char head[24]{};
+	const int read = _read(handle, head, sizeof(head));
+	_close(handle);
+	const size_t got = read > 0 ? static_cast<size_t>(read) : 0u;
+	const char* dot = strrchr(path, '.');
+	if (dot && !strcmp(dot, TextureList_FileFormat))
+		return got >= 21 ? head[17] | head[18] << 8 | head[19] << 16 | head[20] << 24 : 0;
+	return got >= 18 ? head[16] | head[17] << 8 : 0;
+}
