+extern "C" WYD_EXPORT const char* wyd_debug_myhuman_mesh_texture(int index) {
+  static char out[300];
+  out[0] = 0;
+  TMScene* scene = g_pObjectManager ? g_pObjectManager->GetCurrentScene() : nullptr;
+  TMHuman* human = scene ? scene->m_pMyHuman : nullptr;
+  if (!human || !human->m_pSkinMesh || !g_pTextureManager) return out;
+  int n = index;
+  CMesh* mesh = WydNthMesh(human->m_pSkinMesh->m_pRoot, &n);
+  if (!mesh) return out;
+  const int tex = mesh->m_nTextureIndex;
+  const char* name = tex >= 0 && tex < MAX_MODEL_TEXTURE ? g_pTextureManager->m_stModelTextureList[tex].szFileName : "?";
+  std::snprintf(out, sizeof(out), "%d|%s|multi=%d|legend=%d", tex, name, mesh->m_sMultiType, mesh->m_sLegendType);
+  return out;
+}
