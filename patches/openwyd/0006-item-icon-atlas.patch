+// Texture diagnostics (read-only): the size the renderer sees for a UI
+// texture (which = 0 width, 1 height), and item table fields used by icons.
+extern "C" WYD_EXPORT int wyd_debug_ui_texture_size(int index, int which) {
+  if (!g_pTextureManager) return -1;
+  IDirect3DTexture9* tex = g_pTextureManager->GetUITexture(index, 2000);
+  if (!tex) return -2;
+  D3DSURFACE_DESC desc{};
+  if (FAILED(tex->GetLevelDesc(0, &desc))) return -3;
+  return which == 0 ? static_cast<int>(desc.Width) : static_cast<int>(desc.Height);
+}
+
+extern "C" WYD_EXPORT int wyd_debug_item_field(int item, int field) {
+  if (item < 0 || item >= MAX_ITEMLIST) return -99999;
+  const STRUCT_ITEMLIST& it = g_pItemList[item];
+  switch (field) {
+    case 0: return g_itemicon[item];
+    case 1: return it.nGrade;
+    case 2: return it.nIndexMesh;
+    case 3: return it.nIndexTexture;
+    case 4: return it.nPos;
+    case 5: return it.nPrice;
+    default: return -99999;
+  }
+}
