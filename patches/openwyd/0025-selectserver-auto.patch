+int WydCellCenter(SGridControl* g, int x, int y, int which) {
+  if (!g || !g->IsVisible() || g->m_nColumnGridCount <= 0 || g->m_nRowGridCount <= 0 ||
+      x < 0 || y < 0 || x >= g->m_nColumnGridCount || y >= g->m_nRowGridCount ||
+      g->m_GCPanel.nWidth <= 0 || g->m_GCPanel.nHeight <= 0)
+    return -1;
+  const float cw = g->m_GCPanel.nWidth / g->m_nColumnGridCount;
+  const float ch = g->m_GCPanel.nHeight / g->m_nRowGridCount;
+  return static_cast<int>(which == 0 ? g->m_GCPanel.nPosX + cw * (x + 0.5f)
+                                     : g->m_GCPanel.nPosY + ch * (y + 0.5f));
+}
