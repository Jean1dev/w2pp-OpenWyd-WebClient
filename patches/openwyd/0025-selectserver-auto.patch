+// ---- Online automation (etapa 4) ----
+// Each helper drives the original scene controls through OnControlEvent, the
+// same path a click takes, so the scene builds and sends its own packets. None
+// of them fabricate a packet or read one back. Selecting a class sample and a
+// character slot replaces the 3D mouse pick; the rest is the original UI flow.
+#if defined(__EMSCRIPTEN__)
+#include <emscripten/emscripten.h>
+#define WYD_EXPORT EMSCRIPTEN_KEEPALIVE
+#else
+#define WYD_EXPORT
+#endif
+// Test-harness entry points are not KEEPALIVE: the link exports them by name
+// (link_tmproject_wasm_startup.py), and the published build (--public) leaves
+// them out, since KEEPALIVE cannot be undone at link time.
+#define WYD_DEBUG_EXPORT
+
+static TMSelectCharScene* WydSelectCharScene() {
+  if (!g_pObjectManager) return nullptr;
+  TMScene* scene = g_pObjectManager->GetCurrentScene();
+  if (!scene || scene->GetSceneType() != ESCENE_TYPE::ESCENE_SELCHAR) return nullptr;
+  return static_cast<TMSelectCharScene*>(scene);
+}
+
+// 0 locked, 1 unlocked, 2 verify sent, 3..5 PIN change steps.
+extern "C" WYD_EXPORT int wyd_selchar_account_lock() { return g_AccountLock; }
+
+// Etapa 7: when every channel of every group points to the same address the
+// list offers no real choice, so the page skips it. Entry [group][0] is the
+// status URL; channels start at 1. Returns 1 when the login panel opened, 0
+// when not ready yet (other scene, opening animation, panel hidden, message
+// box, or the player went back to the list), and -1 when it does not apply
+// (no channel, different addresses, or the original OK refused the channel).
+static int WydServerListSingleAddress() {
+  const char* first = nullptr;
+  for (int group = 0; group < MAX_SERVERGROUP; ++group) {
+    for (int channel = 1; channel < MAX_SERVERNUMBER; ++channel) {
+      const char* address = g_pServerList[group][channel];
+      if (!address[0]) continue;
+      if (!first) first = address;
+      else if (std::strncmp(first, address, sizeof g_pServerList[0][0]) != 0) return 0;
+    }
+  }
+  return first ? 1 : 0;
+}
+
+// It drives the original controls in the order a player clicks them (first
+// group, first channel, OK), so B_SERVER_SEL_OK picks the address and shows
+// the login panel itself. Nothing is typed or sent.
+extern "C" WYD_EXPORT int wyd_selectserver_auto() {
+  if (!g_pObjectManager) return 0;
+  TMScene* scene = g_pObjectManager->GetCurrentScene();
+  if (!scene || scene->GetSceneType() != ESCENE_TYPE::ESCENE_SELECT_SERVER) return 0;
+
+  auto* select_server = static_cast<TMSelectServerScene*>(scene);
+  if (!select_server->m_pNServerSelect || !select_server->m_pNServerGroupList ||
+      !select_server->m_pNServerList) {
+    return -1;
+  }
+  if (select_server->m_cLogin != 0 || select_server->m_bGameGradePlay ||
+      !select_server->m_pNServerSelect->IsVisible()) {
+    return 0;
+  }
+  if (select_server->m_pMessageBox && select_server->m_pMessageBox->IsVisible()) return 0;
+  if (!WydServerListSingleAddress() || select_server->m_pNServerGroupList->m_nNumItem < 1) return -1;
+
+  select_server->m_pNServerGroupList->SetSelectedIndex(0);
+  select_server->OnControlEvent(L_SELECT_SERVERG, 0);
+  if (select_server->m_pNServerList->m_nNumItem < 1) return -1;
+
+  select_server->m_pNServerList->SetSelectedIndex(0);
+  select_server->OnControlEvent(B_SERVER_SEL_OK, 0);
+  return select_server->m_cLogin == 1 ? 1 : -1;
+}
+
+// Types the PIN on the shuffled keypad (buttons 66437..66446 show keybuf[])
+// and presses the verify button (66433). The digits are not kept.
+extern "C" WYD_DEBUG_EXPORT int wyd_debug_selchar_pin(const char* pin) {
+  TMSelectCharScene* scene = WydSelectCharScene();
+  if (!scene || !pin || g_AccountLock != 0) return 0;
+  const size_t len = std::strlen(pin);
+  if (len < 4 || len > 6) return 0;
+  std::memset(scene->keypass, 0, sizeof(scene->keypass));
+  for (size_t i = 0; i < len; ++i) {
+    if (pin[i] < '0' || pin[i] > '9') return 0;
+    int button = -1;
+    for (int b = 0; b < 10; ++b) {
+      if (scene->keybuf[b] == pin[i] - '0') button = b;
+    }
+    if (button < 0) return 0;
+    scene->OnControlEvent(66437 + button, 0);
+  }
+  return scene->OnControlEvent(66433, 0);
+}
