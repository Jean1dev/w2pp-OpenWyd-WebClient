+extern "C" void wyd_compare_latch_present_state() {
+  g_wyd_compare_present_game_state_valid = g_pObjectManager != nullptr;
+  if (g_pObjectManager) {
+    g_wyd_compare_present_game_state =
+        static_cast<int>(g_pObjectManager->m_eCurrentState);
