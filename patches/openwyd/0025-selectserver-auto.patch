+  return -1;
+}
+extern "C" WYD_EXPORT int wyd_field_party_member(unsigned int id) {
+  auto* p = g_pObjectManager ? static_cast<TMHuman*>(g_pObjectManager->GetHumanByID(id)) : nullptr;
+  return p ? p->m_bParty : -1;
+}
+extern "C" WYD_EXPORT int wyd_field_party_menu_target() {
+  auto* f = WydField();
+  return f && f->m_pPGTPanel && f->m_pPGTPanel->IsVisible() ? f->m_dwOpID : 0;
+}
+
+// Trade probes: snapshots of the original trade window, never input shortcuts.
+// Fields: 0 visible, 1 opponent, 2 my check (617), 3 opponent check (601),
+// 4 my money, 5 opponent money as drawn (603).
+extern "C" WYD_EXPORT int wyd_field_trade_value(int field) {
+  auto* f = WydField();
+  if (!f || !f->m_pTradePanel || !g_pObjectManager) return -1;
+  auto* c = f->m_pControlContainer;
+  switch (field) {
+    case 0: return f->m_pTradePanel->IsVisible() ? 1 : 0;
+    case 1: return static_cast<int>(g_pObjectManager->m_stTrade.OpponentID);
+    case 2: { auto* b = static_cast<SButton*>(c->FindControl(617u)); return b ? b->m_bSelected : -1; }
+    case 3: { auto* b = static_cast<SButton*>(c->FindControl(601u)); return b ? b->m_bSelected : -1; }
+    case 4: return g_pObjectManager->m_stTrade.TradeMoney;
+    case 5: { auto* t = static_cast<SText*>(c->FindControl(603u)); return t && t->GetText() ? std::atoi(t->GetText()) : -1; }
+  }
+  return -1;
+}
+// side 0: my offer grid (8448+k), 1: opponent grid (8192+k): item index or 0.
+// side 2: carry slot recorded for my offer k (-1 when empty).
+extern "C" WYD_EXPORT int wyd_field_trade_item(int side, int k) {
+  auto* f = WydField();
+  if (!f || !g_pObjectManager || k < 0 || k >= 15) return -1;
+  if (side == 2) return g_pObjectManager->m_stTrade.CarryPos[k];
+  if (side != 0 && side != 1) return -1;
+  auto* g = static_cast<SGridControl*>(f->m_pControlContainer->FindControl((side ? 8192u : 8448u) + k));
+  if (!g) return -1;
+  auto* it = g->GetItem(0, 0);
+  return it && it->m_pItem ? it->m_pItem->sIndex : 0;
+}
+
+// Character deletion through the original controls: 4615 opens box 4615, the
+// harness confirms it with wyd_debug_scene_msgbox_ok, which opens the password
+// panel. The password is typed into the original field and cleared after 65886.
+extern "C" WYD_DEBUG_EXPORT int wyd_debug_selchar_open_delete(int slot) {
+  TMSelectCharScene* scene = WydSelectCharScene();
+  if (!scene || slot < 0 || slot >= 4 || g_AccountLock != 1) return 0;
+  if (!scene->m_pHuman[slot] || !g_pObjectManager->m_stSelCharData.MobName[slot][0]) return 0;
+  g_pObjectManager->m_cCharacterSlot = static_cast<char>(slot);
+  scene->OnControlEvent(4615, 0);
+  return scene->m_pMessageBox && scene->m_pMessageBox->IsVisible() && scene->m_pMessageBox->m_dwMessage == 4615 ? 1 : 0;
+}
+extern "C" WYD_EXPORT int wyd_selchar_delete_panel_visible() {
+  TMSelectCharScene* scene = WydSelectCharScene();
+  return scene && scene->m_pInputPWPanel && scene->m_pInputPWPanel->IsVisible() ? 1 : 0;
+}
+extern "C" WYD_DEBUG_EXPORT int wyd_debug_selchar_delete(const char* password) {
+  TMSelectCharScene* scene = WydSelectCharScene();
+  if (!scene || !password || !scene->m_pPWEdit || !scene->m_pInputPWPanel || !scene->m_pInputPWPanel->IsVisible()) return 0;
+  char buf[16] = {0};
+  std::snprintf(buf, sizeof(buf), "%s", password);
+  scene->m_pPWEdit->SetText(buf);
+  std::memset(buf, 0, sizeof(buf));
+  const int r = scene->OnControlEvent(65886, 0);
+  std::memset(scene->m_pPWEdit->m_strText, 0, sizeof(scene->m_pPWEdit->m_strText));
+  return r;
+}
+
+// ---- Settings panel: sound effects and music levels (etapa 7) ----
+// Levels use the Config.bin scale (0..100; 0 = off). Before boot they are kept
+// for NewApp::Initialize; after boot they go to the live managers with the
+// original curves: effects 25 * n - 2500, music 30 * n - 3000 (hundredths of dB).
+static int g_wydAudioPendingLevel[2] = {-1, -1};
+
+extern "C" int wyd_audio_pending_level(int which) {
+  return which == 0 || which == 1 ? g_wydAudioPendingLevel[which] : -1;
+}
+
+extern "C" WYD_EXPORT int wyd_audio_set_levels(int sound, int music) {
+  sound = sound < 0 ? 0 : (sound > 100 ? 100 : sound);
+  music = music < 0 ? 0 : (music > 100 ? 100 : music);
+  g_wydAudioPendingLevel[0] = sound;
+  g_wydAudioPendingLevel[1] = music;
+  if (!g_pApp) return 0;
+  g_pApp->m_nSound = sound;
+  g_pApp->m_nMusic = music;
+  if (g_pApp->m_pSoundManager)
+    g_pApp->m_pSoundManager->SetSoundVolume(sound > 0 ? 25 * sound - 2500 : -10000);
+  if (g_pApp->m_pBGMManager)
+    g_pApp->m_pBGMManager->SetVolume(0, music > 0 ? 30 * music - 3000 : -10000);
+  return 1;
+}
+
+// 0 effects, 1 music: the level in use (the pending one before boot), or -1.
+extern "C" WYD_EXPORT int wyd_audio_get_level(int which) {
+  if (which != 0 && which != 1) return -1;
+  if (!g_pApp) return g_wydAudioPendingLevel[which];
+  return which == 0 ? g_pApp->m_nSound : g_pApp->m_nMusic;
+}
