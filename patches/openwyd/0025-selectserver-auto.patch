+      !select_server->m_pLoginBtns[0]) {
+    return 0;
+  }
+
+  if (host && host[0]) {
+    std::snprintf(g_pApp->m_szServerIP, sizeof(g_pApp->m_szServerIP), "%s", host);
+  }
+  if (!g_pApp->m_szServerIP[0]) return 0;
