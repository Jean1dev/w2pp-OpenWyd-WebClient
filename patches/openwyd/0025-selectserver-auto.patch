+// Texture file, multi (sanc) and legend type of the n-th mesh of the own
+// character's skin (read-only; "" past the last mesh).
+static CMesh* WydNthMesh(CFrame* frame, int* n) {
+  for (CFrame* node = frame; node; node = node->m_pSibling) {
+    if (node->m_pMesh && (*n)-- == 0) return node->m_pMesh;
+    if (node->m_pFirstChild) {
+      if (CMesh* m = WydNthMesh(node->m_pFirstChild, n)) return m;
+    }
+  }
+  return nullptr;
+}
