+// Loaded terrain block (TMGround offset index, 128x128 cells per block). This is
+// the map the client actually rendered, unlike HomeTownX/Y which a teleport keeps.
+extern "C" WYD_EXPORT int wyd_field_ground_index_x() {
+  if (!g_pCurrentScene || g_pCurrentScene->GetSceneType() != ESCENE_TYPE::ESCENE_FIELD || !g_pCurrentScene->m_pGround)
+    return -1;
+  return g_pCurrentScene->m_pGround->m_vecOffsetIndex.x;
+}
+
+extern "C" WYD_EXPORT int wyd_field_ground_index_y() {
+  if (!g_pCurrentScene || g_pCurrentScene->GetSceneType() != ESCENE_TYPE::ESCENE_FIELD || !g_pCurrentScene->m_pGround)
+    return -1;
+  return g_pCurrentScene->m_pGround->m_vecOffsetIndex.y;
+}
