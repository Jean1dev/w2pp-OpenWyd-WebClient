{
  "name": "openwyd-local-verification",
  "private": true,
  "version": "0.0.0",
  "devDependencies": {
    "playwright": "1.54.2"
  },
  "scripts": {
    "scene": "python tools/build_local_scene.py --page-only && node tools/verify_local_scene.mjs",
    "scene:package": "python tools/build_local_scene.py && node tools/verify_local_scene.mjs",
    "gateway:test": "python tools/gateway_test.py",
    "assets:cache": "node tools/verify_asset_cache.mjs",
    "protocol:vectors": "python tools/protocol/cpsock_ref.py --check && python tools/protocol/gen_vectors.py && python tools/protocol/run_go_vectors.py",
    "protocol:dialect": "python tools/apply_openwyd_patches.py && python tools/protocol/run_dialect_test.py",
    "client:stream": "python tools/build_local_scene.py --page-only && node tools/verify_client_stream.mjs",
    "dev": "node tools/dev_railway.mjs",
    "world:checks": "node --test tools/world_checks.test.mjs tools/area_checks.test.mjs tools/party_checks.test.mjs tools/trade_checks.test.mjs",
    "world": "node tools/verify_world_suite.mjs"
  }
}
